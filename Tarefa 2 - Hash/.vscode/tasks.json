{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compilar e rodar",
      "type": "shell",
      "command": "g++ -g main.cpp -o main.exe && start \"Programa\" cmd /c \"main.exe & pause\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "silent", "clear": true }
    }
  ]
}